{
  "version": "4.0.0",
  "name": "holly-react",
  "description": "React version of Holly",
  "author": "Luke McDonald (https://lukemcdonald.com/)",
  "homepage": "https://totono-xyz.github.io/landing/",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/totono-xyz/landing.git"
  },
  "bugs": {
    "url": "https://github.com/totono-xyz/landing.git/issues"
  },
  "scripts": {
    "build": "NODE_ENV=production run-s build:*",
    "build:css": "postcss styles/tailwind.css -o src/assets/styles.css",
    "build:vite": "vite build",
    "deploy": "gh-pages -d dist",
    "dev": "run-p dev:*",
    "dev:css": "postcss styles/tailwind.css -o src/assets/styles.css --watch",
    "dev:vite": "vite",
    "format": "prettier --write .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint . --fix",
    "predeploy": "$npm_execpath run build",
    "preview": "vite preview",
    "start": "$npm_execpath run dev",
    "typecheck": "tsc --noEmit",
    "validate": "run-p lint typecheck"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "clsx": "^2.1.1",
    "gh-pages": "^6.3.0",
    "postcss-import": "^16.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "scrollreveal": "^4.0.9",
    "tailwind-merge": "^3.5.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/scrollreveal": "^0.0.11",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2
  }
}
